<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ============================================================
         DEFAULT DOCUMENTS
         IIS will look for these files in order when a directory is hit
         ============================================================ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ============================================================
         STATIC CONTENT / MIME TYPES
         Ensure modern file types are served correctly
         ============================================================ -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <remove fileExtension=".woff"  />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp"  />
      <mimeMap fileExtension=".webp"  mimeType="image/webp" />
      <remove fileExtension=".svg"   />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <remove fileExtension=".ico"   />
      <mimeMap fileExtension=".ico"   mimeType="image/x-icon" />
    </staticContent>

    <!-- ============================================================
         PHP HANDLER MAPPING (FastCGI)
         Requires:
           1. PHP installed (e.g. C:\PHP\php-cgi.exe)
           2. CGI feature enabled in IIS
           3. FastCGI application registered in IIS (php-cgi.exe)
         Use PHP Manager for IIS to configure this automatically:
           https://www.iis.net/downloads/microsoft/php-manager
         ============================================================ -->
    <handlers>
      <remove name="PHP_via_FastCGI" />
      <add name="PHP_via_FastCGI"
           path="*.php"
           verb="GET,HEAD,POST"
           modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe"
           resourceType="File"
           requireAccess="Script" />
    </handlers>

    <!-- ============================================================
         URL REWRITE RULES
         Requires: IIS URL Rewrite Module 2.x
           https://www.iis.net/downloads/microsoft/url-rewrite
         ============================================================ -->
    <rewrite>
      <rules>

        <!-- Rule 1: PHP files — let them execute directly, no rewrite -->
        <rule name="PHP files passthrough" stopProcessing="true">
          <match url=".*\.php$" />
          <action type="None" />
        </rule>

        <!-- Rule 2: Static assets (JS, CSS, images, fonts) — serve directly -->
        <rule name="Static assets passthrough" stopProcessing="true">
          <match url=".*\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|webp|txt|xml|json)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Rule 3: Existing files/directories — serve directly -->
        <rule name="Existing files passthrough" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Rule 4: SPA fallback — route all unknown URLs to index.html
             Next.js static export generates per-route HTML files so
             most routes will be caught by Rule 3 above. This is a
             safety net for any client-side navigation edge cases. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!-- ============================================================
         HTTP RESPONSE HEADERS — Security hardening
         ============================================================ -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options"        value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection"       value="1; mode=block" />
        <add name="Referrer-Policy"        value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"     value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!-- ============================================================
         COMPRESSION
         ============================================================ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ============================================================
         CACHING — Long cache for hashed assets, short for HTML
         ============================================================ -->
    <caching>
      <profiles>
        <!-- HTML pages — no cache so updates are always fresh -->
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
        <!-- Hashed JS/CSS assets — cache for 1 year -->
        <add extension=".js"   policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" duration="365.00:00:00" />
        <add extension=".css"  policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" duration="365.00:00:00" />
      </profiles>
    </caching>

    <!-- ============================================================
         ERROR PAGES — Custom error pages
         ============================================================ -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>
</configuration>
